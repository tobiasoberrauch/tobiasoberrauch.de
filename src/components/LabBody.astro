---
import ForceGraph from './ForceGraph';
import { t } from '../i18n/translations';
import type { Locale } from '../i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const p = t[locale].pages.lab;
---

<section class="lab-header">
  <div class="page-badge">{p.badge}</div>
  <h1>{p.title}</h1>
  <p class="page-intro">{p.lead}</p>
</section>

<section class="demo-section scroll-reveal">
  <div class="demo-header">
    <div class="demo-badge">{p.demoBadge}</div>
    <h2>{p.demoTitle}</h2>
    <p>{p.demoBody}</p>
  </div>
  <div class="demo-container">
    <ForceGraph client:visible />
  </div>
</section>

<section class="experiments-section">
  <h2 class="section-heading scroll-reveal">
    <span class="heading-line"></span>
    {p.experimentsHeading}
  </h2>
  <div class="experiments">
    {p.experiments.map((exp, i) => (
      <div class="experiment scroll-reveal" style={`transition-delay:${i * 0.05}s`}>
        <div class="exp-meta">
          <span class="exp-number">{String(i + 1).padStart(2, '0')}</span>
          <span class="exp-tag">{p.comingSoon}</span>
        </div>
        <h3>{exp.title}</h3>
        <p>{exp.body}</p>
        <div class="exp-tech">
          {exp.tech.map((tag) => <span>{tag}</span>)}
        </div>
      </div>
    ))}
  </div>
</section>

<section class="cta scroll-reveal">
  <div class="cta-inner">
    <p>{p.ctaText}</p>
    <a href="mailto:tobias.oberrauch@gmx.de">{p.ctaLink}</a>
  </div>
</section>

<style>
  .lab-header { margin-bottom: 2.5rem; }
  .page-badge {
    display: inline-block;
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-accent);
    background: var(--color-accent-light);
    padding: 0.3rem 0.9rem;
    border-radius: 99px;
    margin-bottom: 1.25rem;
  }
  h1 {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 5vw, 3.4rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    margin: 0 0 1.25rem;
  }
  .page-intro {
    color: var(--color-muted);
    font-size: 1.08rem;
    max-width: 620px;
    line-height: 1.7;
  }
  .demo-section { margin-bottom: 4rem; }
  .demo-header { margin-bottom: 1.5rem; }
  .demo-badge {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.25rem 0.8rem;
    border-radius: 99px;
    margin-bottom: 0.75rem;
    background: #D5EDE2;
    color: #15603D;
    animation: pulse-subtle 3s ease-in-out infinite;
  }
  @keyframes pulse-subtle {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.7; }
  }
  .demo-header h2 {
    font-family: var(--font-display);
    font-size: 1.5rem;
    margin: 0 0 0.5rem;
    letter-spacing: -0.02em;
  }
  .demo-header p {
    color: var(--color-muted);
    font-size: 0.95rem;
    max-width: 520px;
  }
  .demo-container {
    border-radius: var(--radius);
    overflow: hidden;
  }
  .section-heading {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: 1.4rem;
    margin-bottom: 1.5rem;
    font-family: var(--font-display);
    letter-spacing: -0.02em;
  }
  .heading-line {
    display: block;
    width: 32px;
    height: 2px;
    background: var(--color-accent);
    border-radius: 2px;
  }
  .experiments {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    margin-bottom: 4rem;
  }
  .experiment {
    background: rgba(255, 255, 255, 0.5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 1.75rem;
    transition: all var(--transition);
    position: relative;
    overflow: hidden;
  }
  .experiment::after {
    content: '';
    position: absolute;
    bottom: 0; left: 0; right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--color-accent), var(--color-secondary));
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .experiment:hover {
    border-color: var(--color-border-hover);
    box-shadow: var(--shadow-md);
    transform: translateY(-3px);
  }
  .experiment:hover::after { transform: scaleX(1); }
  .exp-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
  }
  .exp-number {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 300;
    color: var(--color-border-hover);
  }
  .exp-tag {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.2rem 0.65rem;
    border-radius: 99px;
    background: var(--color-bg-alt);
    color: var(--color-muted);
    border: 1px solid var(--color-border);
  }
  .experiment h3 {
    font-size: 1.15rem;
    margin: 0 0 0.4rem;
    font-weight: 600;
  }
  .experiment p {
    color: var(--color-muted);
    font-size: 0.93rem;
    line-height: 1.6;
    margin-bottom: 0.75rem;
  }
  .exp-tech {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }
  .exp-tech span {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-muted);
    background: var(--color-bg-alt);
    padding: 0.15rem 0.55rem;
    border-radius: 6px;
    border: 1px solid var(--color-border);
  }
  .cta-inner {
    background: var(--color-bg-alt);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius);
    padding: 2rem;
    text-align: center;
  }
  .cta-inner p { color: var(--color-muted); margin-bottom: 0.5rem; }
  .cta-inner a { font-weight: 500; color: var(--color-accent); }
  @media (max-width: 1024px) {
    .experiments { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 640px) {
    .experiments { grid-template-columns: 1fr; }
  }
</style>
