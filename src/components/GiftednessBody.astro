---
import { getCollection } from 'astro:content';
import { t } from '../i18n/translations';
import type { Locale } from '../i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const p = t[locale].pages.giftedness;

// Articles are in German MDX collection
const entries = await getCollection('hochbegabung');
const articles = entries
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99))
  .map((entry) => ({
    title: entry.data.title,
    date: entry.data.date,
    description: entry.data.description,
    slug: entry.id,
  }));
---

<section class="gift-header">
  <div class="page-badge">{p.badge}</div>
  <h1>{p.title}</h1>
  <p class="page-intro">{p.lead}</p>
</section>

<section class="stats-section scroll-reveal">
  <h2 class="stats-title">{p.statsTitle}</h2>
  <div class="stats-grid">
    {p.stats.map((s) => (
      <div class="stat-item">
        <div class="stat-value">{s.value}</div>
        <div class="stat-label">{s.label}</div>
      </div>
    ))}
  </div>
</section>

<section class="topic-map scroll-reveal">
  <h2 class="section-heading">
    <span class="heading-line"></span>
    {p.topicsHeading}
  </h2>
  <div class="topics-grid">
    {p.topics.map((topic, i) => (
      <div class="topic-card scroll-reveal" style={`transition-delay:${i * 0.05}s`}>
        <h3>{topic.title}</h3>
        <p>{topic.body}</p>
      </div>
    ))}
  </div>
</section>

{articles.length > 0 && (
  <section class="articles-section scroll-reveal">
    <h2 class="section-heading">
      <span class="heading-line"></span>
      {p.articlesHeading}
    </h2>
    {locale !== 'de' && <p class="articles-note">{p.articlesGermanOnly}</p>}
    <ul class="article-list">
      {articles.map((a, i) => (
        <li>
          <a href={`/de/neurodivergenz/${a.slug}/`} class="article-card" hreflang="de">
            <div class="article-number">{String(i + 1).padStart(2, '0')}</div>
            <div class="article-content">
              {a.date && <time>{new Date(a.date).toLocaleDateString(locale === 'de' ? 'de-DE' : locale === 'en' ? 'en-US' : 'de-DE', { day: 'numeric', month: 'long', year: 'numeric' })}</time>}
              <h3>{a.title}</h3>
              {a.description && <p>{a.description}</p>}
            </div>
            <span class="article-arrow">→</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
)}

<section class="hb-cta scroll-reveal">
  <div class="cta-box">
    <h2>{p.ctaTitle}</h2>
    <p>{p.ctaBody}</p>
    <a href={`mailto:${p.ctaEmail}`} class="btn-primary">{p.ctaButton}</a>
  </div>
</section>

<style>
  .gift-header { margin-bottom: 2rem; }
  .page-badge {
    display: inline-block;
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-secondary);
    background: var(--color-secondary-light);
    padding: 0.3rem 0.9rem;
    border-radius: 99px;
    margin-bottom: 1.25rem;
  }
  .page-intro {
    color: var(--color-muted);
    font-size: 1.08rem;
    max-width: 620px;
    line-height: 1.7;
  }
  h1 {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 5vw, 3.4rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    margin: 0 0 1.25rem;
  }
  .stats-section {
    background: rgba(255, 255, 255, 0.55);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 2.5rem 2rem;
    margin: 2.5rem 0 3rem;
  }
  .stats-title {
    text-align: center;
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--color-muted);
    margin: 0 0 2rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-family: var(--font-body);
  }
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
    justify-items: center;
  }
  .stat-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
  }
  .stat-value {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 2.8rem);
    font-weight: 700;
    color: var(--color-accent);
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .stat-label {
    font-size: 0.85rem;
    color: var(--color-muted);
    text-align: center;
  }
  .section-heading {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: 1.4rem;
    margin-bottom: 1.5rem;
    font-family: var(--font-display);
    letter-spacing: -0.02em;
  }
  .heading-line {
    display: block;
    width: 32px;
    height: 2px;
    background: var(--color-accent);
    border-radius: 2px;
  }
  .topics-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
    margin-bottom: 3.5rem;
  }
  .topic-card {
    background: rgba(255, 255, 255, 0.5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 1.5rem;
    transition: all var(--transition);
  }
  .topic-card:hover {
    border-color: var(--color-secondary);
    box-shadow: var(--shadow-md);
    transform: translateY(-3px);
  }
  .topic-card h3 {
    font-size: 1.05rem;
    margin: 0 0 0.4rem;
    font-weight: 600;
  }
  .topic-card p {
    color: var(--color-muted);
    font-size: 0.92rem;
    line-height: 1.6;
    margin: 0;
  }
  .articles-section {
    margin-bottom: 3rem;
  }
  .articles-note {
    font-size: 0.85rem;
    color: var(--color-muted);
    font-style: italic;
    margin-bottom: 1rem;
  }
  .article-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin: 0;
  }
  .article-card {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: 1.5rem;
    background: rgba(255, 255, 255, 0.5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    transition: all var(--transition);
    color: var(--color-text);
    text-decoration: none;
  }
  .article-card:hover {
    border-color: var(--color-accent);
    box-shadow: var(--shadow-md);
    transform: translateX(6px);
    color: var(--color-text);
  }
  .article-number {
    font-family: var(--font-display);
    font-size: 1.8rem;
    font-weight: 300;
    color: var(--color-border-hover);
    line-height: 1;
    flex-shrink: 0;
    width: 40px;
    text-align: center;
  }
  .article-card:hover .article-number { color: var(--color-accent); }
  .article-content { flex: 1; }
  .article-content time {
    font-size: 0.8rem;
    color: var(--color-muted);
  }
  .article-content h3 {
    font-size: 1.1rem;
    margin: 0.2rem 0 0.3rem;
    font-weight: 600;
  }
  .article-content p {
    color: var(--color-muted);
    font-size: 0.9rem;
    line-height: 1.5;
    margin: 0;
  }
  .article-arrow {
    font-size: 1.2rem;
    color: var(--color-border-hover);
    transition: all var(--transition);
    flex-shrink: 0;
  }
  .article-card:hover .article-arrow {
    color: var(--color-accent);
    transform: translateX(4px);
  }
  .hb-cta { margin-top: 1rem; }
  .cta-box {
    background: linear-gradient(135deg, var(--color-accent-light), rgba(213, 237, 226, 0.4));
    border: 1px solid rgba(180, 83, 9, 0.15);
    border-radius: var(--radius);
    padding: 2.5rem;
    text-align: center;
  }
  .cta-box h2 {
    margin-top: 0;
    font-family: var(--font-display);
    font-size: 1.5rem;
    letter-spacing: -0.02em;
  }
  .cta-box p {
    color: var(--color-text-soft);
    max-width: 460px;
    margin: 0 auto 1.5rem;
  }
  .btn-primary {
    display: inline-flex;
    padding: 0.75rem 1.6rem;
    background: var(--color-accent);
    color: white;
    font-weight: 500;
    border-radius: 12px;
    text-decoration: none;
    box-shadow: 0 2px 16px var(--color-accent-glow);
    transition: all var(--transition);
  }
  .btn-primary:hover {
    background: var(--color-accent-hover);
    color: white;
    transform: translateY(-2px);
  }
  @media (max-width: 1024px) {
    .stats-grid { grid-template-columns: repeat(2, 1fr); }
    .topics-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 640px) {
    .stats-grid { grid-template-columns: repeat(2, 1fr); }
    .topics-grid { grid-template-columns: 1fr; }
    .article-number { display: none; }
  }
</style>
