---
import { t } from '../i18n/translations';
import type { Locale } from '../i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const p = t[locale].pages.about;

const technologies = ['Python', 'TypeScript', 'Rust', 'Astro', 'RAG', 'Ollama', 'LLMs', 'Claude', 'Angular', 'SQLite'];
const projects = [
  { name: 'rag-showcase', sub: 'RAG demonstration', href: 'https://github.com/tobiasoberrauch/rag-showcase' },
  { name: 'ollama-monitor', sub: 'Terminal monitor for Ollama', href: 'https://github.com/tobiasoberrauch/ollama-monitor' },
  { name: 'parameter-golf', sub: 'Smallest LM training', href: 'https://github.com/tobiasoberrauch/parameter-golf' },
  { name: 'kindle-capture', sub: 'Kindle → vector DB pipeline', href: 'https://github.com/tobiasoberrauch/kindle-capture' },
];
---

<section class="about-header">
  <div class="page-badge">{p.badge}</div>
  <h1>{p.title}</h1>
</section>

<div class="about-hero scroll-reveal">
  <img
    src="/images/tobias-audius.webp"
    alt={p.name}
    class="portrait-photo"
    width="96"
    height="96"
  />
  <div class="hero-meta">
    <h2 class="hero-name">{p.name}</h2>
    <p class="hero-role">{p.role}</p>
    <p class="hero-location">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
      {p.location}
    </p>
  </div>
</div>

<div class="about-grid">
  <div class="about-main">
    {p.sections.map((section, i) => (
      <section class="about-section scroll-reveal" style={`transition-delay:${i * 0.05}s`}>
        <h2>{section.heading}</h2>
        {section.body.map((para) => <p>{para}</p>)}
      </section>
    ))}

    <section class="about-section scroll-reveal">
      <h2>{p.whatHeading}</h2>
      <ul class="what-list">
        {p.whatItems.map((item) => (
          <li>
            <span class="what-icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
            </span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </section>
  </div>

  <aside class="about-sidebar">
    <div class="sidebar-card scroll-reveal">
      <h3>{p.steckbriefHeading}</h3>
      <dl class="steckbrief">
        {p.steckbrief.map((item) => (
          <>
            <dt>{item.label}</dt>
            <dd>{item.value}</dd>
          </>
        ))}
      </dl>
    </div>

    <div class="sidebar-card scroll-reveal">
      <h3>{p.techHeading}</h3>
      <div class="tech-tags">
        {technologies.map((tech) => <span>{tech}</span>)}
      </div>
    </div>

    <div class="sidebar-card scroll-reveal">
      <h3>{p.projectsHeading}</h3>
      <ul class="project-list">
        {projects.map((proj) => (
          <li>
            <a href={proj.href} target="_blank" rel="noopener">
              <strong>{proj.name}</strong>
              <span>{proj.sub}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </aside>
</div>

<section class="contact-section scroll-reveal">
  <h2>{p.contactHeading}</h2>
  <div class="contact-cards">
    <a href="mailto:tobias.oberrauch@gmx.de" class="contact-card">
      <div class="contact-icon">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <rect x="2" y="4" width="20" height="16" rx="2"/><path d="M22 4L12 13L2 4"/>
        </svg>
      </div>
      <div>
        <div class="contact-label">{p.contactLabels.email}</div>
        <div class="contact-value">tobias.oberrauch@gmx.de</div>
      </div>
    </a>
    <a href="https://github.com/tobiasoberrauch" target="_blank" rel="noopener" class="contact-card">
      <div class="contact-icon">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
      </div>
      <div>
        <div class="contact-label">{p.contactLabels.github}</div>
        <div class="contact-value">@tobiasoberrauch</div>
      </div>
    </a>
    <a href="https://de.linkedin.com/in/tobiasoberrauch" target="_blank" rel="noopener" class="contact-card">
      <div class="contact-icon">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
      </div>
      <div>
        <div class="contact-label">{p.contactLabels.linkedin}</div>
        <div class="contact-value">Tobias Oberrauch</div>
      </div>
    </a>
  </div>
</section>

<style>
  .about-header { margin-bottom: 2rem; }
  .page-badge {
    display: inline-block;
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-accent);
    background: var(--color-accent-light);
    padding: 0.3rem 0.9rem;
    border-radius: 99px;
    margin-bottom: 1.25rem;
  }
  h1 {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 5vw, 3.4rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    margin: 0;
  }
  .about-hero {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-bottom: 3rem;
    padding: 2rem;
    background: rgba(255, 255, 255, 0.55);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
  }
  .portrait-photo {
    flex-shrink: 0;
    width: 96px;
    height: 96px;
    border-radius: 22px;
    object-fit: cover;
    box-shadow: 0 4px 20px var(--color-accent-glow);
    border: 3px solid rgba(255, 255, 255, 0.9);
  }
  .hero-name {
    font-family: var(--font-display);
    font-size: 1.55rem;
    margin: 0 0 0.25rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .hero-role {
    font-size: 1rem;
    color: var(--color-accent);
    font-weight: 500;
    margin: 0 0 0.35rem;
  }
  .hero-location {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.9rem;
    color: var(--color-muted);
    margin: 0;
  }
  .about-grid {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 2.5rem;
    margin-bottom: 3rem;
  }
  .about-section { margin-bottom: 2.5rem; }
  .about-section h2 {
    font-family: var(--font-display);
    font-size: 1.5rem;
    letter-spacing: -0.02em;
    margin-top: 0;
  }
  .about-section p {
    line-height: 1.8;
    font-size: 1.02rem;
  }
  .what-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .what-list li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    background: rgba(255, 255, 255, 0.5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    font-size: 0.98rem;
    transition: all var(--transition);
  }
  .what-list li:hover {
    border-color: var(--color-accent);
    transform: translateX(4px);
  }
  .what-icon {
    color: var(--color-accent);
    display: flex;
    flex-shrink: 0;
  }
  .sidebar-card {
    background: rgba(255, 255, 255, 0.5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 1.5rem;
    margin-bottom: 1.25rem;
  }
  .sidebar-card h3 {
    font-size: 0.82rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-muted);
    margin: 0 0 1rem;
    font-family: var(--font-body);
  }
  .steckbrief {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.4rem 1rem;
    font-size: 0.9rem;
    margin: 0;
  }
  .steckbrief dt {
    color: var(--color-muted);
    font-weight: 400;
  }
  .steckbrief dd {
    color: var(--color-text);
    font-weight: 500;
    margin: 0;
  }
  .tech-tags {
    display: flex;
    gap: 0.35rem;
    flex-wrap: wrap;
  }
  .tech-tags span {
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--color-muted);
    background: var(--color-bg-alt);
    padding: 0.2rem 0.6rem;
    border-radius: 6px;
    border: 1px solid var(--color-border);
    transition: all var(--transition);
  }
  .tech-tags span:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
  .project-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .project-list li a {
    display: flex;
    flex-direction: column;
    padding: 0.6rem 0.75rem;
    border-radius: var(--radius-sm);
    transition: all var(--transition);
    text-decoration: none;
    color: var(--color-text);
  }
  .project-list li a:hover {
    background: var(--color-bg-alt);
    transform: translateX(4px);
  }
  .project-list li a strong {
    font-size: 0.9rem;
    font-weight: 600;
  }
  .project-list li a span {
    font-size: 0.8rem;
    color: var(--color-muted);
  }
  .contact-section h2 {
    margin-top: 0;
    font-family: var(--font-display);
    font-size: 1.5rem;
    letter-spacing: -0.02em;
  }
  .contact-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }
  .contact-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem 1.5rem;
    background: rgba(255, 255, 255, 0.5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    transition: all var(--transition);
    color: var(--color-text);
    text-decoration: none;
  }
  .contact-card:hover {
    border-color: var(--color-accent);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
    color: var(--color-text);
  }
  .contact-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    background: var(--color-accent-light);
    color: var(--color-accent);
    border-radius: 10px;
    flex-shrink: 0;
    transition: all var(--transition);
  }
  .contact-card:hover .contact-icon {
    background: var(--color-accent);
    color: white;
  }
  .contact-label {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-muted);
    font-weight: 500;
    margin-bottom: 0.15rem;
  }
  .contact-value {
    font-size: 0.95rem;
    font-weight: 500;
  }
  @media (max-width: 1024px) {
    .about-grid { grid-template-columns: 1fr 300px; gap: 2rem; }
  }
  @media (max-width: 768px) {
    .about-grid { grid-template-columns: 1fr; }
    .about-sidebar { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
    .sidebar-card { margin-bottom: 0; }
    .contact-cards { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 640px) {
    .about-hero { flex-direction: column; align-items: flex-start; gap: 1rem; }
    .about-sidebar { grid-template-columns: 1fr; }
    .contact-cards { grid-template-columns: 1fr; }
  }
</style>
