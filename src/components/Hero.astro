---
import HeroCanvas from './HeroCanvas';
import { t } from '../i18n/translations';
import { getLocalePath, getPillarPath, type Locale } from '../i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const h = t[locale].hero;
const writingPath = getPillarPath(locale, 'writing');
---

<section class="hero reveal" lang={locale === 'grc' ? 'grc' : undefined}>
  <div class="hero-canvas-wrap">
    <HeroCanvas client:load />
  </div>
  <div class="hero-content">
    <div class="hero-intro reveal reveal-delay-1">
      <img
        src="/images/tobias-github.jpg"
        alt="Tobias Oberrauch"
        class="hero-avatar"
        width="56"
        height="56"
      />
      <div>
        <div class="hero-badge">{h.badge}</div>
      </div>
    </div>
    <h1 class="reveal reveal-delay-2">
      {h.thesis}<br/><span class="name-highlight">{h.thesisName}</span>
    </h1>
    <p class="lead reveal reveal-delay-3">{h.subline}</p>
    <div class="hero-links reveal reveal-delay-4">
      <a href={writingPath} class="btn-primary">{h.primaryCta}</a>
      <a href="#pillars" class="btn-ghost">{h.secondaryCta}</a>
    </div>
    <div class="hero-social reveal reveal-delay-5">
      <a href="https://github.com/tobiasoberrauch" target="_blank" rel="noopener" aria-label="GitHub" class="social-link">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
      </a>
      <a href="https://de.linkedin.com/in/tobiasoberrauch" target="_blank" rel="noopener" aria-label="LinkedIn" class="social-link">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
      </a>
      <a href="mailto:tobias.oberrauch@gmx.de" aria-label="E-Mail" class="social-link">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M22 4L12 13L2 4"/></svg>
      </a>
    </div>
  </div>
  <div class="scroll-hint reveal reveal-delay-6">
    <span>{h.scrollHint}</span>
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M19 12l-7 7-7-7"/></svg>
  </div>
</section>

<style>
  .hero {
    position: relative;
    width: 100vw;
    height: 100vh;
    display: flex;
    align-items: center;
    left: 50%;
    margin-left: -50vw;
    margin-top: -64px;
    margin-bottom: 0;
    padding: 5rem max(var(--padding-x), calc((100vw - var(--max-width-full)) / 2 + var(--padding-x))) 4rem;
    overflow: hidden;
  }
  .hero-canvas-wrap {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .hero-content {
    position: relative;
    z-index: 1;
    max-width: 760px;
  }
  .hero-intro {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  .hero-avatar {
    width: 56px;
    height: 56px;
    border-radius: 16px;
    object-fit: cover;
    box-shadow: 0 4px 16px var(--color-accent-glow);
    flex-shrink: 0;
    border: 2px solid rgba(255, 255, 255, 0.8);
  }
  .hero-badge {
    display: inline-block;
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-accent);
    background: rgba(254, 243, 199, 0.85);
    backdrop-filter: blur(8px);
    padding: 0.35rem 1rem;
    border-radius: 99px;
    border: 1px solid rgba(180, 83, 9, 0.1);
  }
  .hero h1 {
    font-size: clamp(2.6rem, 6.5vw, 4.6rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.03em;
    margin-bottom: 1.5rem;
    font-variation-settings: 'opsz' 144;
  }
  .name-highlight {
    background: linear-gradient(135deg, var(--color-accent), #D97706, #92400E);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .lead {
    font-size: clamp(1.05rem, 1.4vw, 1.2rem);
    line-height: 1.7;
    color: var(--color-muted);
    max-width: 620px;
    margin-bottom: 2rem;
  }
  .hero-links {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 2rem;
  }
  .hero-social {
    display: flex;
    gap: 0.5rem;
  }
  .social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 10px;
    color: var(--color-muted);
    background: rgba(255, 255, 255, 0.5);
    border: 1px solid var(--color-border);
    transition: all var(--transition);
    backdrop-filter: blur(8px);
  }
  .social-link:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
    background: rgba(254, 243, 199, 0.5);
    transform: translateY(-2px);
  }
  .btn-primary {
    display: inline-flex;
    align-items: center;
    padding: 0.85rem 1.8rem;
    background: var(--color-accent);
    color: white;
    font-weight: 500;
    font-size: 0.95rem;
    border-radius: 12px;
    transition: all var(--transition);
    text-decoration: none;
    box-shadow: 0 2px 16px var(--color-accent-glow);
  }
  .btn-primary:hover {
    background: var(--color-accent-hover);
    color: white;
    transform: translateY(-2px);
    box-shadow: 0 6px 24px var(--color-accent-glow);
  }
  .btn-ghost {
    display: inline-flex;
    align-items: center;
    padding: 0.85rem 1.8rem;
    color: var(--color-text-soft);
    font-weight: 500;
    font-size: 0.95rem;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    transition: all var(--transition);
    text-decoration: none;
    background: rgba(255, 255, 255, 0.5);
    backdrop-filter: blur(8px);
  }
  .btn-ghost:hover {
    border-color: var(--color-border-hover);
    background: rgba(255, 255, 255, 0.8);
    color: var(--color-text);
  }
  .scroll-hint {
    position: absolute;
    bottom: 2.5rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-muted);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    z-index: 1;
  }
  .scroll-hint svg {
    animation: bounceDown 2s ease-in-out infinite;
  }
  @keyframes bounceDown {
    0%, 100% { transform: translateY(0); opacity: 0.5; }
    50% { transform: translateY(8px); opacity: 1; }
  }
  :global([lang='grc']) h1 {
    letter-spacing: -0.01em;
  }
  @media (max-width: 768px) {
    .hero { height: 100vh; padding: 3.5rem var(--padding-x) 3rem; }
  }
  @media (max-width: 640px) {
    .hero { height: 100svh; padding: 2.5rem var(--padding-x) 2rem; }
    .hero h1 { font-size: 2.4rem; }
    .hero-intro { flex-direction: column; align-items: flex-start; gap: 0.75rem; }
  }
</style>
