---
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';

export async function getStaticPaths() {
  const articles = await getCollection('hochbegabung');
  return articles.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const allArticles = await getCollection('hochbegabung');
const sorted = allArticles.sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
const currentIndex = sorted.findIndex((a) => a.id === entry.id);
const prev = currentIndex > 0 ? sorted[currentIndex - 1] : null;
const next = currentIndex < sorted.length - 1 ? sorted[currentIndex + 1] : null;
---

<Base title={entry.data.title} description={entry.data.description}>
  <article class="article-page">
    <div class="article-nav-top">
      <a href="/de/neurodivergenz/" class="back-link">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
        Alle Artikel
      </a>
    </div>

    <header class="article-header reveal">
      {entry.data.date && (
        <time class="article-date reveal reveal-delay-1">
          {new Date(entry.data.date).toLocaleDateString('de-DE', { day: 'numeric', month: 'long', year: 'numeric' })}
        </time>
      )}
      <h1 class="reveal reveal-delay-2">{entry.data.title}</h1>
      {entry.data.description && (
        <p class="article-description reveal reveal-delay-3">{entry.data.description}</p>
      )}
    </header>

    <div class="article-body reveal reveal-delay-4">
      <Content />
    </div>

    <nav class="article-pagination">
      {prev ? (
        <a href={`/de/neurodivergenz/${prev.id}/`} class="pagination-link prev">
          <span class="pagination-label">Vorheriger Artikel</span>
          <span class="pagination-title">{prev.data.title}</span>
        </a>
      ) : <div />}
      {next ? (
        <a href={`/de/neurodivergenz/${next.id}/`} class="pagination-link next">
          <span class="pagination-label">Nächster Artikel</span>
          <span class="pagination-title">{next.data.title}</span>
        </a>
      ) : <div />}
    </nav>
  </article>
</Base>

<style>
  .article-page {
    width: 100%;
  }

  .article-nav-top {
    margin-bottom: 2rem;
  }
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--color-muted);
    transition: color var(--transition);
  }
  .back-link:hover { color: var(--color-accent); }

  .article-header {
    margin-bottom: 2.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--color-border);
  }
  .article-date {
    display: block;
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: 0.75rem;
  }
  .article-header h1 {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    line-height: 1.2;
    margin-bottom: 1rem;
  }
  .article-description {
    font-size: 1.1rem;
    color: var(--color-text-soft);
    line-height: 1.7;
    max-width: 600px;
  }

  .article-body {
    font-size: 1.02rem;
    line-height: 1.85;
    color: var(--color-text-soft);
  }
  .article-body :global(h2) {
    font-size: 1.5rem;
    margin: 2.5rem 0 1rem;
    color: var(--color-text);
  }
  .article-body :global(h3) {
    font-size: 1.2rem;
    margin: 2rem 0 0.75rem;
    color: var(--color-text);
  }
  .article-body :global(p) {
    margin-bottom: 1.25rem;
  }
  .article-body :global(strong) {
    color: var(--color-text);
    font-weight: 600;
  }
  .article-body :global(a) {
    color: var(--color-accent);
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: rgba(180, 83, 9, 0.3);
    text-underline-offset: 2px;
    transition: text-decoration-color var(--transition);
  }
  .article-body :global(a:hover) {
    text-decoration-color: var(--color-accent);
  }
  .article-body :global(ul), .article-body :global(ol) {
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
  }
  .article-body :global(li) {
    margin-bottom: 0.4rem;
  }
  .article-body :global(blockquote) {
    border-left: 3px solid var(--color-accent);
    margin: 1.5rem 0;
    padding: 1rem 1.5rem;
    background: var(--color-accent-light);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    font-style: italic;
    color: var(--color-text);
  }
  .article-body :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    font-size: 0.92rem;
  }
  .article-body :global(th) {
    text-align: left;
    padding: 0.75rem 1rem;
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    font-weight: 600;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-muted);
  }
  .article-body :global(td) {
    padding: 0.65rem 1rem;
    border: 1px solid var(--color-border);
    vertical-align: top;
  }

  .article-pagination {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }
  .pagination-link {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 1.25rem;
    background: rgba(255,255,255,0.5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    text-decoration: none;
    color: var(--color-text);
    transition: all var(--transition);
  }
  .pagination-link:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px);
    box-shadow: var(--shadow-sm);
    color: var(--color-text);
  }
  .pagination-link.next { text-align: right; }
  .pagination-label {
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-accent);
  }
  .pagination-title {
    font-weight: 500;
    font-size: 0.95rem;
  }

  @media (max-width: 640px) {
    .article-pagination { grid-template-columns: 1fr; }
  }
</style>
