import PillarPage from '../../components/PillarPage.astro';
import { t } from '../../i18n/translations';

const locale = 'la' as const;
const tr = t[locale];
---

<Base title={tr.pages.speaking.title} description={tr.pages.speaking.lead} locale={locale}>
  <PillarPage locale={locale} pillar="speaking" />
</Base>
