---
import Base from '../../layouts/Base.astro';
import { consumeMagicLink, createSession, SESSION_COOKIE } from '../../lib/communitas/auth';

export const prerender = false;

const token = Astro.url.searchParams.get('t');
let consumed: { memberId: number } | null = null;
let errorReason: string | null = null;

if (!token) {
  errorReason = 'no-token';
} else {
  try {
    consumed = await consumeMagicLink(token);
    if (!consumed) errorReason = 'invalid-or-expired';
  } catch (err) {
    console.warn('[login] consumeMagicLink threw', (err as Error).message);
    errorReason = 'server-error';
  }
}

if (consumed) {
  try {
    const userAgent = Astro.request.headers.get('user-agent') ?? undefined;
    const ipCountry =
      (Astro.request.headers.get('x-vercel-ip-country') ?? '')
        .toLowerCase()
        .slice(0, 2) || undefined;
    const cookieValue = await createSession(consumed.memberId, userAgent, ipCountry);
    Astro.cookies.set(SESSION_COOKIE, cookieValue, {
      httpOnly: true,
      secure: true,
      sameSite: 'lax',
      path: '/',
      maxAge: 60 * 60 * 24 * 7, // 7 days
    });
    return Astro.redirect('/communitas-mitglied/');
  } catch (err) {
    console.warn('[login] createSession threw', (err as Error).message);
    errorReason = 'server-error';
  }
}
---

<Base
  title="Anmeldung — Communitas Cotidiana"
  description="Anmeldung zum Mitgliedsbereich."
  locale="de"
>
  <article class="login-error">
    <h1>Der Link ist nicht mehr gültig.</h1>
    <p>
      {errorReason === 'no-token'
        ? 'Es ist kein Anmelde-Token in der Adresse.'
        : 'Der Link ist abgelaufen oder wurde bereits benutzt.'}
    </p>
    <p>Du kannst dir einen neuen schicken lassen:</p>
    <form method="post" action="/api/communitas/auth/magic-link" class="request-form">
      <label>
        <span>Deine Mitglieds-E-Mail</span>
        <input type="email" name="email" required autocomplete="email" inputmode="email" />
      </label>
      <button type="submit">Link senden</button>
      <p class="note">Wenn du eingetragen bist, schicken wir dir einen Link.</p>
    </form>
  </article>

  <style>
    .login-error {
      max-width: 32rem;
      margin: 4rem auto;
      padding: 0 1.25rem;
      font-family: Georgia, 'Times New Roman', Times, serif;
      color: #1c1917;
      line-height: 1.6;
    }
    .login-error h1 {
      font-size: 1.6rem;
      font-weight: 400;
      margin: 0 0 1rem;
    }
    .login-error p {
      margin: 0 0 1em;
    }
    .request-form {
      margin-top: 2rem;
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }
    .request-form label {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
    }
    .request-form input {
      font: inherit;
      padding: 0.5rem 0.75rem;
      border: 1px solid #d6d3d1;
      background: #fefefe;
      color: #1c1917;
      border-radius: 2px;
    }
    .request-form button {
      align-self: flex-start;
      font: inherit;
      padding: 0.5rem 1.25rem;
      background: #1c1917;
      color: #fefefe;
      border: 0;
      border-radius: 2px;
      cursor: pointer;
    }
    .request-form .note {
      color: #78716c;
      font-size: 0.92rem;
      margin: 0;
    }
  </style>
</Base>
